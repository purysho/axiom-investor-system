      "color": "4",
      "x": 1000,
      "y": 644,
      "width": 440,
      "height": 104
    },
    {
      "id": "29fc1a0e355e",
      "type": "text",
      "text": "4  Copilot & Bot",
      "color": "2",
      "x": 1500,
      "y": 0,
      "width": 440,
      "height": 70
    },
    {
      "id": "4d5789bc9b79",
      "type": "text",
      "text": "**copilot/route.ts** — AI proposes a raw candidate\napp/api/copilot/route.ts",
      "color": "2",
