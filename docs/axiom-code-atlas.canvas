{
  "nodes": [
    {
      "id": "27a99427583c",
      "type": "text",
      "text": "1  Market Data",
      "color": "5",
      "x": 0,
      "y": 0,
      "width": 440,
      "height": 70
    },
    {
      "id": "61b1b0611f56",
      "type": "text",
      "text": "**types.ts** — provider interface, classifySymbol\nlib/market-data/types.ts",
      "color": "5",
      "x": 0,
      "y": 116,
      "width": 440,
      "height": 104
    },
    {
      "id": "a8837ed141de",
      "type": "text",
      "text": "**alpaca.ts** — real IEX bars (AlpacaDataProvider)\nlib/market-data/alpaca.ts",
      "color": "5",
      "x": 0,
      "y": 248,
      "width": 440,
      "height": 104
    },
    {
      "id": "e7dd28f10b5a",
      "type": "text",
      "text": "**stooq.ts** — delayed EOD fallback\nlib/market-data/stooq.ts",
      "color": "5",
      "x": 0,
      "y": 380,
      "width": 440,
      "height": 104
    },
    {
      "id": "bcac19f79267",
      "type": "text",
      "text": "**index.ts** — registry + resolveHistory\nlib/market-data/index.ts",
      "color": "5",
      "x": 0,
      "y": 512,
      "width": 440,
      "height": 104
    },
    {
      "id": "677afc6b6979",
      "type": "text",
      "text": "**history.ts** — fetchDailyHistoryForUser (your keys)\nlib/server/history.ts",
      "color": "5",
      "x": 0,
      "y": 644,
      "width": 440,
      "height": 104
    },
    {
      "id": "15cfaa91b3a3",
      "type": "text",
      "text": "2  Strategy & Math",
      "color": "6",
      "x": 500,
      "y": 0,
      "width": 440,
      "height": 70
    },
    {
      "id": "7d10a159859c",
      "type": "text",
      "text": "**strategy.ts** — signalAt — the ONE rule source\nlib/engine/strategy.ts",
      "color": "6",
      "x": 500,
      "y": 116,
      "width": 440,
      "height": 104
    },
    {
      "id": "20651d456708",
      "type": "text",
      "text": "**quotes.ts** — indicators, WARMUP_BARS\nlib/engine/quotes.ts",
      "color": "6",
      "x": 500,
      "y": 248,
      "width": 440,
      "height": 104
    },
    {
      "id": "5812275d34c5",
      "type": "text",
      "text": "**sizing.ts** — computeSizing — risk-first\nlib/engine/sizing.ts",
      "color": "6",
      "x": 500,
      "y": 380,
      "width": 440,
      "height": 104
    },
    {
      "id": "ae5b5bf66165",
      "type": "text",
      "text": "**gate.ts** — six-check risk gate\nlib/engine/gate.ts",
      "color": "6",
      "x": 500,
      "y": 512,
      "width": 440,
      "height": 104
    },
    {
      "id": "4a7a2f4f663d",
      "type": "text",
      "text": "**protections.ts** — behavioural locks\nlib/engine/protections.ts",
      "color": "6",
      "x": 500,
      "y": 644,
      "width": 440,
      "height": 104
    },
    {
      "id": "06c9964f940c",
      "type": "text",
      "text": "3  Backtest & Export",
      "color": "4",
      "x": 1000,
      "y": 0,
      "width": 440,
      "height": 70
    },
    {
      "id": "d64edb478726",
      "type": "text",
      "text": "**backtest.ts** — runBacktest — deterministic\nlib/engine/backtest.ts",
      "color": "4",
      "x": 1000,
      "y": 116,
      "width": 440,
      "height": 104
    },
    {
      "id": "7c34c575c070",
      "type": "text",
      "text": "**algo-report.ts** — .md/.json — evaluate\nlib/engine/algo-report.ts",
      "color": "4",
      "x": 1000,
      "y": 248,
      "width": 440,
      "height": 104
    },
    {
      "id": "8ce5cb5a460c",
      "type": "text",
      "text": "**algo-repro.ts** — Python port — reproduce\nlib/engine/algo-repro.ts",
      "color": "4",
      "x": 1000,
      "y": 380,
      "width": 440,
      "height": 104
    },
    {
      "id": "9808393818dc",
      "type": "text",
      "text": "**backtest-request.ts** — shared prepare (parse-fetch-run)\nlib/server/backtest-request.ts",
      "color": "4",
      "x": 1000,
      "y": 512,
      "width": 440,
      "height": 104
    },
    {
      "id": "63bc9114a5f6",
      "type": "text",
