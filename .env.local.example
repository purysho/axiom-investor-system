# Optional. Free key from https://www.alphavantage.co/support/#api-key (25 requests/day).
# Without it the app uses keyless FRED + Stooq sources and manual entry.
ALPHA_VANTAGE_API_KEY=

# Required in production — sessions are signed with this. Generate: openssl rand -hex 32
SESSION_SECRET=

# Where the SQLite file lives when not using Turso (Docker mounts a volume here).
# DATA_DIR=./data

# Managed-database alternative (Vercel etc.): create a Turso DB and set both.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# In-site AI assistant (optional). Create a key at console.anthropic.com.
# Without it the assistant button still appears but explains it needs setup.
ANTHROPIC_API_KEY=
# Override the assistant model if you want (default: claude-haiku-4-5).
# ASSISTANT_MODEL=

# Public signup. "true" (default) lets anyone create an account; "false" requires an invite code.
SIGNUPS_OPEN=true

# REQUIRED in production. 32+ random chars. The app refuses to boot without it.
# PowerShell:  -join ((1..32)|%{'{0:x}' -f (Get-Random -Max 16)})
SESSION_SECRET=

# Optional. 64 hex chars, encrypts 2FA seeds at rest.
# If unset, a key is derived from SESSION_SECRET — so rotating SESSION_SECRET
# invalidates everyone's 2FA enrolment (they'd re-enrol with a recovery code).
ENCRYPTION_KEY=

# ── Broker (optional) ────────────────────────────────────────────────
# Users connect their OWN Alpaca keys in Settings; nothing is stored here.
# Paper trading works with no extra configuration.
#
# Set this to "true" ONLY when you accept real-money orders can be placed.
# It is a deployment-level switch: the UI cannot override it.
ALLOW_LIVE_TRADING=false
#
# Point the adapter at a different endpoint (testing only).
# ALPACA_BASE_URL=
#
# ── Real market data (optional but recommended) ──────────────────────
# Set these to use Alpaca's REAL IEX daily bars for charts, the Copilot,
# the bot, and backtests instead of the free delayed Stooq feed. ANY valid
# Alpaca key works (paper or live) — this reads market data only, never
# places orders. Unset = the app runs on Stooq exactly as before.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=

# ── AXIOM bot scheduling (optional) ──────────────────────────────────
# The bot always works via "Run now" on /bot. To ALSO run it on a schedule,
# set a token (32+ random chars) and have any external cron POST to
# /api/bot/tick with header "Authorization: Bearer <token>" during market
# hours. Unset = the tick endpoint stays dead. See BOT.md.
# BOT_CRON_TOKEN=
