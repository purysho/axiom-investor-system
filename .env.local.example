# Optional. Free key from https://www.alphavantage.co/support/#api-key (25 requests/day).
# Without it the app uses keyless FRED + Stooq sources and manual entry.
ALPHA_VANTAGE_API_KEY=

# Required in production — sessions are signed with this. Generate: openssl rand -hex 32
SESSION_SECRET=

# Where the SQLite file lives when not using Turso (Docker mounts a volume here).
# DATA_DIR=./data

# Managed-database alternative (Vercel etc.): create a Turso DB and set both.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# In-site AI assistant (optional). Create a key at console.anthropic.com.
# Without it the assistant button still appears but explains it needs setup.
ANTHROPIC_API_KEY=
# Override the assistant model if you want (default: claude-haiku-4-5).
# ASSISTANT_MODEL=
